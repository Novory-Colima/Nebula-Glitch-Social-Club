---
import { siteContent } from '../../core/data/content';
import SectionTitle from '../ui/SectionTitle.astro';
const base = import.meta.env.BASE_URL;

const memoryImages = [
  { src: `${base}images/community-1.png`, speed: 0.8, align: 'left' },
  { src: `${base}images/community-2.png`, speed: 1.2, align: 'right' },
  { src: `${base}images/community-3.png`, speed: 0.9, align: 'left' },
  { src: `${base}images/community-4.png`, speed: 1.4, align: 'right' },
];
---

<section id="community" class="relative py-32 md:py-64 bg-black z-10 overflow-hidden">
  <!-- Warm glow -->
  <div class="absolute top-1/2 left-0 w-[40%] h-[40%] -translate-y-1/2 rounded-full bg-[var(--color-accent-primary)] blur-[200px] opacity-[0.04] mix-blend-screen"></div>

  <!-- Memory Void Parallax Container -->
  <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden">
    {memoryImages.map((img, i) => (
      <div 
        class={`memory-fragment absolute rounded-xl p-2 md:p-3 bg-white/5 backdrop-blur-sm shadow-2xl border border-white/10 ${img.align === 'left' ? 'left-[-10%] md:left-[5%]' : 'right-[-10%] md:right-[5%]'} ${i === 0 ? 'top-[10%]' : i === 1 ? 'top-[30%]' : i === 2 ? 'top-[60%]' : 'top-[80%]'}`}
        data-speed={img.speed}
        data-align={img.align}
      >
        <img src={img.src} class="w-32 h-40 md:w-56 md:h-72 object-cover rounded-lg" alt="Community Memory" />
      </div>
    ))}
  </div>

  <div class="container mx-auto px-6 md:px-12 max-w-6xl relative z-10">
    
    <!-- Header — large, editorial -->
    <div class="mb-32 max-w-2xl relative">
      <span class="community-label block text-[11px] uppercase tracking-[0.3em] text-[var(--color-accent-primary)] font-secondary mb-8 opacity-0 translate-y-4">
        {siteContent.community.label}
      </span>
      
      <SectionTitle as="h2" class="text-4xl md:text-5xl lg:text-7xl font-light text-[var(--color-text-primary)] mb-8 leading-[1.1] whitespace-pre-line drop-shadow-2xl">
        {siteContent.community.title}
      </SectionTitle>

      <p class="community-desc text-lg md:text-xl text-[var(--color-text-secondary)] font-secondary leading-relaxed opacity-0 translate-y-6 max-w-xl drop-shadow-xl">
        {siteContent.community.description}
      </p>
    </div>

    <!-- Events — editorial horizontal layout with large numbering -->
    <div class="community-events flex flex-col relative z-10 bg-black/40 backdrop-blur-md rounded-3xl p-6 md:p-12 border border-white/5">
      {siteContent.community.events.map((event, index) => (
        <article 
          class={`community-event group flex flex-col md:flex-row md:items-baseline gap-4 md:gap-12 py-10 opacity-0 translate-y-6 ${index > 0 ? 'border-t border-[var(--color-border-subtle)]' : ''}`}
          data-index={index}
        >
          <!-- Index number — large, decorative -->
          <span class="text-5xl md:text-7xl font-display font-bold text-[var(--color-surface-elevated)] group-hover:text-[var(--color-accent-primary)] transition-colors duration-700 leading-none select-none">
            {String(index + 1).padStart(2, '0')}
          </span>
          
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between flex-1 gap-4">
            <div class="flex flex-col gap-2">
              <h3 class="text-xl md:text-2xl font-display text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] transition-colors duration-500">
                {event.name}
              </h3>
              <p class="text-sm text-[var(--color-text-secondary)] font-secondary max-w-sm">
                {event.description}
              </p>
            </div>
            
            <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-accent-primary)] md:text-[var(--color-text-secondary)] font-secondary whitespace-nowrap">
              {event.day}
            </span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initCommunityAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.community-label, .community-desc, .community-event, .memory-fragment', { opacity: 1, y: 0 });
      return;
    }

    gsap.to('.community-label', {
      scrollTrigger: { trigger: '#community', start: 'top 70%' },
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    });

    gsap.to('.community-desc', {
      scrollTrigger: { trigger: '.community-desc', start: 'top 80%' },
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    });

    gsap.utils.toArray('.community-event').forEach((event, i) => {
      gsap.to(event as HTMLElement, {
        scrollTrigger: { trigger: event as HTMLElement, start: 'top 88%' },
        opacity: 1,
        y: 0,
        duration: DURATIONS.entrance,
        ease: EASINGS.premiumEntrance,
        delay: i * 0.08,
      });
    });

    // Memory Void Parallax
    const fragments = gsap.utils.toArray('.memory-fragment');
    fragments.forEach((frag) => {
      const el = frag as HTMLElement;
      const speed = parseFloat(el.getAttribute('data-speed') || '1');
      const align = el.getAttribute('data-align');
      const yMove = (1 - speed) * 500;
      const xMove = align === 'left' ? 100 : -100; // Converge to center

      // Initial state: blurred, grayscale, scaled up
      gsap.set(el, { filter: "blur(20px) grayscale(100%)", scale: 1.25, opacity: 0 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#community',
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        }
      });

      // Parallax movement throughout the section
      tl.to(el, { y: yMove, x: xMove, ease: "none" }, 0);

      // Focus pull in the first 40% of scroll
      gsap.to(el, {
        scrollTrigger: {
          trigger: el,
          start: 'top 90%',
          end: 'top 40%',
          scrub: true,
        },
        filter: "blur(0px) grayscale(0%)",
        scale: 1,
        opacity: 0.6, // Keep slightly transparent so it stays in background
        ease: "power2.out"
      });
    });
  };

  document.addEventListener('astro:page-load', initCommunityAnimation);
</script>
