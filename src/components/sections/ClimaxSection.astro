---
import { siteContent } from '../../core/data/content';
import PremiumButton from '../ui/PremiumButton.astro';
---

<section id="cta" class="relative min-h-[80vh] flex items-center justify-center bg-[var(--color-bg-primary)] z-30 overflow-hidden">
  
  <!-- Intense Lighting Base -->
  <div class="absolute inset-0 z-0">
    <!-- Grid overlay for subtle tech feel -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"></div>
    
    <!-- Central intense glow -->
    <div class="cta-glow absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[60vw] h-[60vw] rounded-full bg-[var(--color-accent-primary)] blur-[150px] opacity-10 mix-blend-screen scale-50"></div>
    
    <!-- Floating atmospheric particles -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-[20%] left-[20%] w-2 h-2 rounded-full bg-[var(--color-highlight)] blur-[2px] animate-pulse"></div>
      <div class="absolute top-[70%] left-[80%] w-3 h-3 rounded-full bg-[var(--color-glow-secondary)] blur-[3px] animate-pulse [animation-delay:300ms]"></div>
      <div class="absolute top-[40%] left-[70%] w-1 h-1 rounded-full bg-[var(--color-text-primary)] blur-[1px] animate-pulse [animation-delay:700ms]"></div>
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-6 max-w-4xl text-center">
    <h2 class="cta-title text-5xl md:text-7xl lg:text-8xl font-display font-bold text-[var(--color-text-primary)] mb-8 tracking-tight">
      {siteContent.cta.title}
    </h2>
    
    <div class="cta-text-wrapper overflow-hidden mt-8">
      <p class="cta-text text-lg md:text-2xl text-[var(--color-text-secondary)] font-secondary font-light leading-relaxed max-w-2xl mx-auto">
        {siteContent.cta.description}
      </p>
    </div>

    <div class="cta-button mt-12 opacity-0 translate-y-4">
      <PremiumButton class="booking-trigger" id="climax-booking-btn">
        {siteContent.cta.button}
      </PremiumButton>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initCtaAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.cta-button', { opacity: 1, y: 0 });
      return;
    }

    // Expand the glow as the user scrolls into the section
    gsap.to('.cta-glow', {
      scrollTrigger: {
        trigger: '#cta',
        start: 'top 80%',
        end: 'center center',
        scrub: 1,
      },
      scale: 1.5,
      opacity: 0.3,
      ease: 'none',
    });

    // Title reveal
    gsap.fromTo('.cta-title', 
      { 
        opacity: 0, 
        scale: 0.9,
        y: 50
      },
      {
        scrollTrigger: {
          trigger: '#cta',
          start: 'top 60%',
        },
        opacity: 1,
        scale: 1,
        y: 0,
        duration: DURATIONS.transition,
        ease: EASINGS.snap,
      }
    );

    gsap.fromTo('.cta-text', 
      { 
        opacity: 0,
        y: 100 
      },
      {
        scrollTrigger: {
          trigger: '.cta-text-wrapper',
          start: 'top 80%',
        },
        opacity: 1,
        y: 0,
        duration: DURATIONS.entrance,
        ease: EASINGS.premiumEntrance,
        delay: 0.2
      }
    );

    gsap.to('.cta-button', {
      scrollTrigger: {
        trigger: '.cta-button',
        start: 'top 90%',
      },
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
      delay: 0.4,
    });
  };

  document.addEventListener('astro:page-load', initCtaAnimation);
</script>
