---
import { siteContent } from '../../core/data/content';
import PremiumButton from '../ui/PremiumButton.astro';
const base = import.meta.env.BASE_URL;

const collageImages = [
  { src: `${base}images/gallery-1.png`, classes: 'w-48 h-64 md:w-64 md:h-80 -rotate-6' },
  { src: `${base}images/gallery-4.png`, classes: 'w-56 h-40 md:w-72 md:h-56 rotate-3' },
  { src: `${base}images/lounge.png`, classes: 'w-64 h-64 md:w-80 md:h-80 rotate-12' },
  { src: `${base}images/signature.png`, classes: 'w-40 h-56 md:w-56 md:h-72 -rotate-12' },
];
---

<section id="climax" class="relative bg-[var(--color-bg-primary)] z-30 overflow-hidden min-h-screen">
  
  <div id="climax-pin-container" class="relative w-full h-screen flex items-center justify-center">
    
    <!-- Background transition layers -->
    <div class="climax-bg absolute inset-0 bg-black z-0 opacity-0"></div>
    <div class="climax-glow absolute inset-0 bg-gradient-to-b from-[#06070B] to-[#0A061E] z-0 opacity-0 mix-blend-screen"></div>
    
    <!-- Phase 1: Transition Screen (Eye-closing Dissolve) -->
    <div class="transition-text-wrapper absolute inset-0 z-10 flex flex-col items-center justify-center pointer-events-none">
      <p class="transition-text text-2xl md:text-4xl text-white font-secondary font-light opacity-0 text-center tracking-widest px-6">
        Desconecta del exterior.
        <br/><span class="block mt-4 text-[var(--color-accent-primary)] font-display text-3xl md:text-5xl italic">Conecta con tu interior.</span>
      </p>
    </div>

    <!-- Phase 2: Converging Collage -->
    <div class="collage-container absolute inset-0 z-20 flex items-center justify-center pointer-events-none perspective-[1000px]">
      <div class="collage-center relative w-0 h-0 flex items-center justify-center">
        {collageImages.map((img, i) => (
          <div class={`collage-item absolute rounded-xl overflow-hidden shadow-2xl opacity-0 ${img.classes}`} data-index={i}>
            <img src={img.src} class="w-full h-full object-cover scale-[1.2] collage-img" alt="Nebula Climax" />
            <div class="absolute inset-0 bg-black/40 mix-blend-multiply collage-overlay"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- Phase 3: Final CTA -->
    <div class="cta-content absolute inset-0 z-30 flex flex-col items-center justify-center pointer-events-none opacity-0">
      <div class="bg-[var(--color-bg-primary)]/40 backdrop-blur-md border border-[var(--color-border-subtle)]/50 p-12 md:p-20 rounded-3xl text-center max-w-4xl mx-4 shadow-[0_0_50px_rgba(107,90,255,0.1)]">
        <h2 class="text-4xl md:text-6xl lg:text-8xl font-display font-bold text-[var(--color-text-primary)] mb-6 tracking-tight drop-shadow-xl">
          {siteContent.cta.title}
        </h2>
        <p class="text-lg md:text-2xl text-[var(--color-text-secondary)] font-secondary font-light leading-relaxed max-w-2xl mx-auto mb-10 drop-shadow-md">
          {siteContent.cta.description}
        </p>
        <div class="pointer-events-auto">
          <PremiumButton class="booking-trigger" id="climax-booking-btn">
            {siteContent.cta.button}
          </PremiumButton>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  const initClimaxAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.cta-content', { opacity: 1 });
      gsap.set('.collage-item', { opacity: 0.5 });
      return;
    }

    const pinContainer = document.getElementById('climax-pin-container');
    if (!pinContainer) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: "#climax",
        start: "top top",
        end: "+=300%",
        pin: true,
        scrub: 1,
      }
    });

    // 1. Eye closing dissolve
    tl.to('.climax-bg', { opacity: 1, duration: 1 })
      .to('.transition-text', { opacity: 1, y: -20, duration: 1, ease: 'power2.out' }, '<')
      .to({}, { duration: 1 }) // Empty tween for reading time
      .to('.transition-text', { opacity: 0, filter: 'blur(10px)', y: -40, duration: 1, ease: 'power2.in' });

    // 2. Converging Collage and Dark Inversion
    const items = gsap.utils.toArray('.collage-item');
    
    // Set initial random out-of-screen positions for collage items
    items.forEach((item, i) => {
      const el = item as HTMLElement;
      let startX, startY;
      if (i === 0) { startX = -window.innerWidth; startY = -window.innerHeight; }
      else if (i === 1) { startX = window.innerWidth; startY = -window.innerHeight; }
      else if (i === 2) { startX = -window.innerWidth; startY = window.innerHeight; }
      else { startX = window.innerWidth; startY = window.innerHeight; }
      
      gsap.set(el, { x: startX, y: startY, rotationZ: (Math.random() - 0.5) * 90, scale: 2, opacity: 0 });
    });

    tl.to('.climax-glow', { opacity: 1, duration: 2 }, 'collage')
      .to(items, {
        x: (i) => i === 0 ? -150 : i === 1 ? 150 : i === 2 ? -100 : 120, // Spread them slightly from center
        y: (i) => i === 0 ? -100 : i === 1 ? -120 : i === 2 ? 100 : 80,
        rotationZ: (i) => i === 0 ? -10 : i === 1 ? 5 : i === 2 ? -5 : 8,
        scale: 1,
        opacity: 1,
        duration: 2,
        ease: 'expo.out',
        stagger: 0.1
      }, 'collage');

    // 3. CTA Reveal
    tl.to('.collage-overlay', { backgroundColor: 'rgba(0,0,0,0.8)', duration: 1 }, 'cta')
      .to('.cta-content', { opacity: 1, scale: 1, duration: 1.5, ease: 'power3.out' }, 'cta-=0.5');

    // Micro-magnetism on collage items
    if (!matchMedia('(hover: none)').matches) {
      pinContainer.addEventListener('mousemove', (e) => {
        const mouseX = (e.clientX / window.innerWidth - 0.5) * 2;
        const mouseY = (e.clientY / window.innerHeight - 0.5) * 2;

        items.forEach((item, i) => {
          gsap.to(item as HTMLElement, {
            x: "+=" + (mouseX * (i + 1) * 10),
            y: "+=" + (mouseY * (i + 1) * 10),
            rotationX: mouseY * -10,
            rotationY: mouseX * 10,
            duration: 1,
            ease: 'power2.out',
            overwrite: 'auto'
          });
        });
      });
    }
  };

  document.addEventListener('astro:page-load', initClimaxAnimation);
</script>
