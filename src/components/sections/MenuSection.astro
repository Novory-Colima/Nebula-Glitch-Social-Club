---
import { siteContent } from '../../core/data/content';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="menu" class="relative py-32 md:py-48 bg-[var(--color-bg-secondary)] z-10 overflow-hidden">
  <!-- Warm ambient glow -->
  <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[60%] h-[40%] rounded-full bg-[var(--color-highlight)] blur-[200px] opacity-[0.03] mix-blend-screen"></div>

  <div class="container mx-auto px-6 md:px-12 max-w-5xl">
    
    <!-- Header — centered, minimal -->
    <div class="text-center mb-24">
      <span class="menu-label block text-[11px] uppercase tracking-[0.3em] text-[var(--color-highlight)] font-secondary mb-8 opacity-0 translate-y-4">
        {siteContent.menu.label}
      </span>
      <SectionTitle as="h2" class="text-3xl md:text-5xl lg:text-6xl font-light text-[var(--color-text-primary)]">
        {siteContent.menu.title}
      </SectionTitle>
    </div>

    <!-- Menu Grid — 2 columns on desktop, typographic, like a printed menu -->
    <div class="menu-grid grid grid-cols-1 md:grid-cols-2 gap-x-20 gap-y-16">
      {siteContent.menu.categories.map((category, catIndex) => (
        <div class="menu-category opacity-0 translate-y-8" data-index={catIndex}>
          <!-- Category Name -->
          <h3 class="text-xs uppercase tracking-[0.25em] text-[var(--color-accent-primary)] font-secondary mb-8 pb-4 border-b border-[var(--color-border-subtle)]">
            {category.name}
          </h3>

          <!-- Items -->
          <ul class="flex flex-col gap-6">
            {category.items.map((item) => (
              <li class="group flex flex-col gap-1">
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-[var(--color-text-primary)] font-primary text-base group-hover:text-[var(--color-accent-primary)] transition-colors duration-300">
                    {item.name}
                  </span>
                  <!-- Dotted leader line -->
                  <span class="flex-1 border-b border-dotted border-[var(--color-border-subtle)] mb-1 min-w-8"></span>
                  <span class="text-[var(--color-text-primary)] font-primary text-base tabular-nums">
                    {item.price}
                  </span>
                </div>
                <span class="text-xs text-[var(--color-text-secondary)] font-secondary italic">
                  {item.note}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initMenuAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.menu-label, .menu-category', { opacity: 1, y: 0 });
      return;
    }

    gsap.to('.menu-label', {
      scrollTrigger: { trigger: '#menu', start: 'top 70%' },
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    });

    gsap.utils.toArray('.menu-category').forEach((cat, i) => {
      gsap.to(cat as HTMLElement, {
        scrollTrigger: { trigger: cat as HTMLElement, start: 'top 85%' },
        opacity: 1,
        y: 0,
        duration: DURATIONS.entrance,
        ease: EASINGS.premiumEntrance,
        delay: i * 0.12,
      });
    });
  };

  document.addEventListener('astro:page-load', initMenuAnimation);
</script>
