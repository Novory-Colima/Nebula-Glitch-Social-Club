---
import { siteContent } from '../../core/data/content';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="philosophy" class="relative py-32 md:py-48 bg-[var(--color-bg-secondary)] z-10 overflow-hidden">
  <!-- Subtle ambient glow -->
  <div class="absolute top-0 right-0 w-[50%] h-[50%] rounded-full bg-[var(--color-accent-primary)] blur-[200px] opacity-5 mix-blend-screen"></div>

  <div class="container mx-auto px-6 md:px-12 max-w-7xl">
    <!-- Section Label -->
    <span class="philosophy-label block text-[11px] uppercase tracking-[0.3em] text-[var(--color-accent-primary)] font-secondary mb-8 opacity-0 translate-y-4">
      {siteContent.philosophy.label}
    </span>

    <!-- Asymmetric Layout: Image left (breaking grid), Text right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      
      <!-- Editorial Image — oversized, breaks left edge -->
      <div class="philosophy-image lg:col-span-5 relative opacity-0">
        <div class="relative aspect-[3/4] lg:-ml-12 rounded-2xl overflow-hidden">
          <img 
            src="/images/philosophy.png"
            alt="Granos de café de especialidad — proceso de selección y tueste artesanal"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
          <!-- Soft vignette -->
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-secondary)]/40 to-transparent"></div>
        </div>
      </div>

      <!-- Text Content -->
      <div class="lg:col-span-7 flex flex-col gap-10 lg:pt-16">
        <SectionTitle as="h2" class="text-3xl md:text-5xl lg:text-6xl font-light text-[var(--color-text-primary)] leading-[1.1] whitespace-pre-line">
          {siteContent.philosophy.title}
        </SectionTitle>
        
        <p class="philosophy-text text-lg md:text-xl text-[var(--color-text-secondary)] font-secondary leading-relaxed max-w-xl opacity-0 translate-y-8">
          {siteContent.philosophy.description}
        </p>

        <!-- Stats — horizontal, typographic -->
        <div class="philosophy-stats flex flex-wrap gap-12 md:gap-16 mt-8 opacity-0 translate-y-8">
          {siteContent.philosophy.stats.map((stat) => (
            <div class="flex flex-col gap-1">
              <span class="text-4xl md:text-5xl font-display font-bold text-[var(--color-text-primary)]">
                {stat.value}
              </span>
              <span class="text-xs uppercase tracking-[0.2em] text-[var(--color-text-secondary)] font-secondary">
                {stat.label}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initPhilosophyAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.philosophy-label, .philosophy-text, .philosophy-stats, .philosophy-image', { opacity: 1, y: 0 });
      return;
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#philosophy',
        start: 'top 60%',
      }
    });

    tl.to('.philosophy-label', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    })
    .to('.philosophy-image', {
      opacity: 1,
      duration: DURATIONS.transition,
      ease: EASINGS.premiumEntrance,
    }, "-=0.4")
    .to('.philosophy-text', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    }, "-=0.8")
    .to('.philosophy-stats', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.premiumEntrance,
    }, "-=0.4");
  };

  document.addEventListener('astro:page-load', initPhilosophyAnimation);
</script>
