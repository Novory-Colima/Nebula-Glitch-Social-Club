---
import { siteContent } from '../../core/data/content';
import SectionTitle from '../ui/SectionTitle.astro';

const spaceImages = ['space-bar.png', 'space-quiet.png', 'space-gaming.png', 'community-2.png'];
---

<section id="spaces" class="relative bg-[var(--color-bg-primary)] overflow-hidden z-20 h-screen w-full">
  <!-- Progress Bar -->
  <div id="spaces-progress" class="absolute top-0 left-0 h-[2px] bg-[var(--color-accent-primary)] w-0 z-50"></div>
  
  <div id="spaces-pin-container" class="w-full h-full flex items-center">
    <div id="spaces-track" class="flex h-full items-center pl-6 md:pl-24 pr-[20vw] gap-16 md:gap-32 w-max">
      
      <!-- Title Area inside the track -->
      <div class="flex-shrink-0 w-[80vw] md:w-[40vw] opacity-0 spaces-intro">
        <span class="block text-[11px] uppercase tracking-[0.3em] text-[var(--color-glow-secondary)] font-secondary mb-8">
          {siteContent.spaces.label}
        </span>
        <SectionTitle as="h2" class="text-4xl md:text-5xl lg:text-7xl font-light text-[var(--color-text-primary)] leading-[1.1]">
          {siteContent.spaces.title}
        </SectionTitle>
      </div>

      <!-- Each Room -->
      {siteContent.spaces.items.map((space, index) => (
         <article class="space-moment relative flex flex-col justify-center flex-shrink-0 w-[75vw] md:w-[45vw] h-[50vh] md:h-[65vh] group opacity-0">
            <div class="overflow-hidden rounded-2xl w-full h-full relative">
                <img 
                  src={`/images/${spaceImages[index % spaceImages.length]}`} 
                  alt={space.title}
                  class="space-parallax-img absolute top-0 left-[-20%] w-[140%] h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-transparent to-[var(--color-bg-primary)] opacity-80 mix-blend-multiply"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-primary)]/80 via-transparent to-transparent opacity-80"></div>
            </div>
            
            <div class="absolute bottom-8 md:bottom-12 left-8 md:left-12 right-8 text-left space-moment-text translate-y-8">
                <span class="block text-[10px] uppercase tracking-[0.2em] text-[var(--color-accent-primary)] font-secondary mb-3">
                  {space.tag}
                </span>
                <h3 class="text-2xl md:text-4xl font-display text-[var(--color-text-primary)] mb-4">
                  {space.title}
                </h3>
                <p class="text-sm md:text-base text-[var(--color-text-secondary)] font-secondary max-w-md leading-relaxed">
                  {space.description}
                </p>
            </div>
         </article>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';

  const initSpacesAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      gsap.set('.spaces-intro, .space-moment', { opacity: 1, y: 0 });
      gsap.set('.space-moment-text', { y: 0 });
      return;
    }

    const track = document.getElementById('spaces-track');
    const container = document.getElementById('spaces-pin-container');
    const progressBar = document.getElementById('spaces-progress');

    if (!track || !container) return;

    // Calculate total scroll distance based on track width
    const getScrollAmount = () => {
      let trackWidth = track.scrollWidth;
      return -(trackWidth - window.innerWidth);
    };

    // Main Horizontal Scroll Tween
    const tween = gsap.to(track, {
      x: getScrollAmount,
      ease: "none",
      scrollTrigger: {
        trigger: "#spaces",
        start: "top top",
        end: () => `+=${getScrollAmount() * -1}`,
        pin: true,
        scrub: 1,
        invalidateOnRefresh: true
      }
    });

    // Progress Bar Tween
    if (progressBar) {
      gsap.to(progressBar, {
        width: "100%",
        ease: "none",
        scrollTrigger: {
          trigger: "#spaces",
          start: "top top",
          end: () => `+=${getScrollAmount() * -1}`,
          scrub: true
        }
      });
    }

    // Initial fade in for intro
    gsap.to('.spaces-intro', {
      scrollTrigger: {
        trigger: "#spaces",
        start: "top 80%",
      },
      opacity: 1,
      duration: 1,
      ease: "power2.out"
    });

    // Internal Animations using containerAnimation
    const moments = gsap.utils.toArray('.space-moment');
    moments.forEach((moment: any, i) => {
      
      // Fade in the whole card when it enters the viewport horizontally
      gsap.to(moment, {
        opacity: 1,
        ease: "power2.out",
        duration: 1,
        scrollTrigger: {
          trigger: moment,
          containerAnimation: tween,
          start: "left 85%",
        }
      });

      // Text slide up
      const textBlock = moment.querySelector('.space-moment-text');
      if (textBlock) {
        gsap.to(textBlock, {
          y: 0,
          ease: "power3.out",
          duration: 1.2,
          scrollTrigger: {
            trigger: moment,
            containerAnimation: tween,
            start: "left 75%",
          }
        });
      }

      // Image Parallax (Horizontal)
      const img = moment.querySelector('.space-parallax-img');
      if (img) {
        gsap.to(img, {
          xPercent: 20,
          ease: "none",
          scrollTrigger: {
            trigger: moment,
            containerAnimation: tween,
            start: "left right",
            end: "right left",
            scrub: true,
          }
        });
      }
    });
  };

  document.addEventListener('astro:page-load', initSpacesAnimation);
</script>
