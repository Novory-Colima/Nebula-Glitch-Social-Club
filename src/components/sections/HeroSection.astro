---
import { siteContent } from '../../core/data/content';
import PremiumButton from '../ui/PremiumButton.astro';
---

<section id="hero" class="relative min-h-screen flex items-end overflow-hidden pb-24 md:pb-32">
  <!-- Cinematic Background Image -->
  <div class="absolute inset-0 z-0">
    <img 
      src="/images/hero.png" 
      alt="Interior de Nebula Glitch Social Club — Cafetería de especialidad"
      class="w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <!-- Gradient overlays for readability and atmosphere -->
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-[var(--color-bg-primary)]/60 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-primary)]/80 to-transparent"></div>
  </div>

  <!-- Atmospheric Glow -->
  <div class="absolute top-[-20%] right-[-10%] w-[40%] h-[40%] rounded-full bg-[var(--color-glow-primary)] blur-[120px] opacity-10 mix-blend-screen z-[1]"></div>

  <!-- Content — anchored to the bottom-left for editorial composition -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12">
    <div class="max-w-2xl flex flex-col gap-6">
      <h1 class="hero-title text-6xl md:text-8xl lg:text-9xl font-bold tracking-tighter text-[var(--color-text-primary)] leading-[0.9] opacity-0 translate-y-12">
        {siteContent.hero.title}
      </h1>
      <h2 class="hero-subtitle text-lg md:text-2xl font-light tracking-[0.25em] text-[var(--color-accent-primary)] opacity-0 translate-y-8">
        {siteContent.hero.subtitle}
      </h2>
      <p class="hero-tagline text-xl md:text-2xl text-[var(--color-text-secondary)] font-secondary font-light mt-2 opacity-0 translate-y-8">
        {siteContent.hero.tagline}
      </p>
      <div class="hero-actions flex flex-wrap gap-4 mt-4 opacity-0 translate-y-4">
        <PremiumButton href="#philosophy">
          {siteContent.hero.cta}
        </PremiumButton>
        <PremiumButton href="#menu" class="border-transparent text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">
          {siteContent.hero.ctaMenu}
        </PremiumButton>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero-scroll absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 z-10">
    <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-secondary)]">Scroll</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-[var(--color-text-secondary)] to-transparent"></div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initHeroAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    
    if (prefersReducedMotion) {
      gsap.set('.hero-title, .hero-subtitle, .hero-tagline, .hero-actions, .hero-scroll', { 
        opacity: 1, 
        y: 0 
      });
      return;
    }

    const tl = gsap.timeline({ defaults: { ease: EASINGS.premiumEntrance } });

    tl.to('.hero-title', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.cinematic,
    })
    .to('.hero-subtitle', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.transition,
    }, "-=1.2")
    .to('.hero-tagline', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
    }, "-=0.8")
    .to('.hero-actions', {
      opacity: 1,
      y: 0,
      duration: DURATIONS.entrance,
    }, "-=0.6")
    .to('.hero-scroll', {
      opacity: 1,
      duration: DURATIONS.entrance,
    }, "-=0.4");
  };

  document.addEventListener('astro:page-load', initHeroAnimation);
</script>
