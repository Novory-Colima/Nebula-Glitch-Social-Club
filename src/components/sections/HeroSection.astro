---
import { siteContent } from '../../core/data/content';
import PremiumButton from '../ui/PremiumButton.astro';
---

<section id="hero" class="relative min-h-screen flex items-end overflow-hidden pb-24 md:pb-32" data-parallax="true">
  <!-- Cinematic Background Layers -->
  <div class="absolute inset-0 z-0 scale-110 origin-center parallax-bg">
    <img 
      src="/images/hero.png" 
      alt="Interior de Nebula Glitch Social Club — Cafetería de especialidad"
      class="w-full h-full object-cover object-center"
      loading="eager"
      decoding="async"
    />
    <!-- Gradient overlays for readability and atmosphere -->
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-bg-primary)] via-[var(--color-bg-primary)]/70 to-transparent mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-bg-primary)]/90 to-transparent"></div>
  </div>

  <!-- Interactive Atmospheric Glow -->
  <div id="interactive-glow" class="absolute top-0 left-0 w-[60vw] h-[60vw] md:w-[40vw] md:h-[40vw] rounded-full bg-[var(--color-glow-primary)] blur-[120px] opacity-20 mix-blend-screen z-[1] -translate-x-1/2 -translate-y-1/2 hidden md:block"></div>
  <!-- Mobile Static Glow -->
  <div class="absolute top-[-20%] right-[-10%] w-[60%] h-[60%] rounded-full bg-[var(--color-glow-primary)] blur-[100px] opacity-15 mix-blend-screen z-[1] md:hidden"></div>

  <!-- Content — anchored to the bottom-left for editorial composition -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 pointer-events-none">
    <div class="max-w-3xl flex flex-col gap-6">
      <h1 class="hero-title text-6xl md:text-8xl lg:text-9xl font-bold tracking-tighter text-[var(--color-text-primary)] leading-[0.9]">
        {siteContent.hero.title}
      </h1>
      <h2 class="hero-subtitle text-lg md:text-2xl font-light tracking-[0.25em] text-[var(--color-accent-primary)] overflow-hidden">
        <span class="block translate-y-full opacity-0">{siteContent.hero.subtitle}</span>
      </h2>
      <p class="hero-tagline text-xl md:text-2xl text-[var(--color-text-secondary)] font-secondary font-light mt-2 overflow-hidden">
        <span class="block translate-y-full opacity-0">{siteContent.hero.tagline}</span>
      </p>
      <div class="hero-actions flex flex-wrap gap-4 mt-4 opacity-0 pointer-events-auto">
        <PremiumButton href="#philosophy">
          {siteContent.hero.cta}
        </PremiumButton>
        <PremiumButton href="#menu" class="border-transparent text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)]">
          {siteContent.hero.ctaMenu}
        </PremiumButton>
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="hero-scroll absolute bottom-12 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-0 z-10">
    <span class="text-[10px] uppercase tracking-widest text-[var(--color-text-secondary)]">Scroll</span>
    <div class="w-[1px] h-12 bg-gradient-to-b from-[var(--color-text-secondary)] to-transparent"></div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';
  import { TextDecoder } from '../../core/motion/TextDecoder';

  const initHeroAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const title = document.querySelector('.hero-title');
    
    if (prefersReducedMotion) {
      gsap.set('.hero-subtitle span, .hero-tagline span', { y: 0, opacity: 1 });
      gsap.set('.hero-actions, .hero-scroll', { opacity: 1 });
      return;
    }

    if (!title) return;

    // Set initial state for animated elements
    gsap.set(title, { opacity: 0 });

    const decoder = new TextDecoder(title as HTMLElement);
    const tl = gsap.timeline({ defaults: { ease: EASINGS.premiumEntrance } });

    // Cinematic Reveal
    tl.to('.parallax-bg', {
      scale: 1,
      duration: 2.5,
      ease: "power2.out"
    })
    .to(title, {
      opacity: 1,
      duration: 0.1,
      onStart: () => {
        decoder.decode(1.5, 0);
      }
    }, 0.3)
    .to('.hero-subtitle span', {
      y: '0%',
      opacity: 1,
      duration: 1,
      ease: "power3.out"
    }, 1.2)
    .to('.hero-tagline span', {
      y: '0%',
      opacity: 1,
      duration: 1,
      ease: "power3.out"
    }, 1.4)
    .to('.hero-actions', {
      opacity: 1,
      duration: 1,
    }, 1.6)
    .to('.hero-scroll', {
      opacity: 1,
      duration: DURATIONS.entrance,
    }, 1.8);

    // Parallax on Scroll
    gsap.to('.parallax-bg', {
      y: '20%',
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: 'bottom top',
        scrub: true
      }
    });

    // Interactive Glow
    const glow = document.getElementById('interactive-glow');
    if (glow && !matchMedia('(hover: none)').matches) {
      const xSet = gsap.quickSetter(glow, "x", "px");
      const ySet = gsap.quickSetter(glow, "y", "px");
      
      let mouseX = window.innerWidth / 2;
      let mouseY = window.innerHeight / 2;
      let currX = mouseX;
      let currY = mouseY;
      
      window.addEventListener('mousemove', (e) => {
        mouseX = e.clientX;
        mouseY = e.clientY;
      });

      gsap.ticker.add(() => {
        const dt = 1.0 - Math.pow(1.0 - 0.05, gsap.ticker.deltaRatio());
        currX += (mouseX - currX) * dt;
        currY += (mouseY - currY) * dt;
        xSet(currX);
        ySet(currY);
      });
    }
  };

  document.addEventListener('astro:page-load', initHeroAnimation);
</script>
