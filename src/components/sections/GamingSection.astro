---
import { siteContent } from '../../core/data/content';
import SectionTitle from '../ui/SectionTitle.astro';
---

<section id="gaming" class="relative py-24 md:py-32 bg-[var(--color-bg-secondary)] z-10 overflow-hidden">
  <!-- Intentionally subtle — no large glow, just a quiet ambience -->
  <div class="absolute bottom-0 right-0 w-[30%] h-[30%] rounded-full bg-[var(--color-glow-secondary)] blur-[150px] opacity-[0.04] mix-blend-screen"></div>

  <div class="container mx-auto px-6 md:px-12 max-w-5xl">
    
    <!-- Deliberately compact section — gaming is secondary -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Left: Text -->
      <div>
        <span class="gaming-label block text-[11px] uppercase tracking-[0.3em] text-[var(--color-text-secondary)] font-secondary mb-8 opacity-0 translate-y-4">
          {siteContent.gaming.label}
        </span>
        
        <SectionTitle as="h2" class="text-2xl md:text-4xl font-light text-[var(--color-text-primary)] mb-8 leading-[1.2] whitespace-pre-line">
          {siteContent.gaming.title}
        </SectionTitle>

        <p class="gaming-text text-base text-[var(--color-text-secondary)] font-secondary leading-relaxed max-w-md opacity-0 translate-y-6">
          {siteContent.gaming.description}
        </p>
      </div>

      <!-- Right: Features — minimal list, no cards -->
      <div class="gaming-features flex flex-col gap-0 opacity-0 translate-y-8">
        {siteContent.gaming.features.map((feature, index) => (
          <div class={`flex items-baseline justify-between py-5 ${index > 0 ? 'border-t border-[var(--color-border-subtle)]' : ''}`}>
            <span class="text-[var(--color-text-primary)] font-primary text-sm">
              {feature.title}
            </span>
            <span class="text-[var(--color-text-secondary)] font-secondary text-xs tracking-wide">
              {feature.detail}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initGamingAnimation = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) {
      gsap.set('.gaming-label, .gaming-text, .gaming-features', { opacity: 1, y: 0 });
      return;
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#gaming',
        start: 'top 65%',
      }
    });

    tl.to('.gaming-label', {
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    })
    .to('.gaming-text', {
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.smooth,
    }, "-=0.5")
    .to('.gaming-features', {
      opacity: 1, y: 0,
      duration: DURATIONS.entrance,
      ease: EASINGS.premiumEntrance,
    }, "-=0.4");
  };

  document.addEventListener('astro:page-load', initGamingAnimation);
</script>
