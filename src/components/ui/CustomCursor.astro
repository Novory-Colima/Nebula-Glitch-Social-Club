---
// src/components/ui/CustomCursor.astro
---
<!-- Outer Ring (Lerped) -->
<div id="custom-cursor-ring" class="fixed top-0 left-0 w-8 h-8 rounded-full border border-[var(--color-accent-primary)] pointer-events-none z-[9998] mix-blend-screen transition-all duration-100 ease-out -translate-x-1/2 -translate-y-1/2 hidden md:block opacity-0"></div>

<!-- Inner Dot (Instant) -->
<div id="custom-cursor-dot" class="fixed top-0 left-0 w-1.5 h-1.5 rounded-full bg-[#F5F7FA] pointer-events-none z-[9999] mix-blend-screen -translate-x-1/2 -translate-y-1/2 hidden md:block opacity-0"></div>

<script>
  import gsap from 'gsap';

  const initCursor = () => {
    const ring = document.getElementById('custom-cursor-ring');
    const dot = document.getElementById('custom-cursor-dot');
    if (!ring || !dot) return;
    
    // Check if device supports hover
    const isTouch = matchMedia('(hover: none)').matches;
    if (isTouch) return;

    gsap.set([ring, dot], { opacity: 1 });

    const pos = { x: window.innerWidth / 2, y: window.innerHeight / 2 };
    const mouse = { x: pos.x, y: pos.y };
    const speed = 0.15; // Ring lerp speed

    const ringXSet = gsap.quickSetter(ring, "x", "px");
    const ringYSet = gsap.quickSetter(ring, "y", "px");
    const dotXSet = gsap.quickSetter(dot, "x", "px");
    const dotYSet = gsap.quickSetter(dot, "y", "px");

    let isHovering = false;

    window.addEventListener("mousemove", e => {    
      mouse.x = e.x;
      mouse.y = e.y;
      
      // Dot moves instantly
      dotXSet(mouse.x);
      dotYSet(mouse.y);
    });

    gsap.ticker.add(() => {
      // Ring lerps with deltaRatio for consistent speed across refresh rates
      const dt = 1.0 - Math.pow(1.0 - speed, gsap.ticker.deltaRatio()); 
      pos.x += (mouse.x - pos.x) * dt;
      pos.y += (mouse.y - pos.y) * dt;
      ringXSet(pos.x);
      ringYSet(pos.y);
    });

    // Interactive elements logic with Event Delegation
    document.addEventListener('mouseover', (e) => {
      const target = (e.target as HTMLElement).closest('a, button, .interactive, select, input[type="submit"]');
      if (target && !isHovering) {
        isHovering = true;
        
        // Hide dot
        gsap.to(dot, { scale: 0, opacity: 0, duration: 0.2 });
        
        // Expand ring, fill it with white and lower opacity
        gsap.to(ring, {
          scale: 1.5,
          backgroundColor: '#F5F7FA',
          borderColor: 'transparent',
          opacity: 0.2,
          duration: 0.3,
          ease: "power2.out"
        });
      }
    });

    document.addEventListener('mouseout', (e) => {
      const target = (e.target as HTMLElement).closest('a, button, .interactive, select, input[type="submit"]');
      if (target && isHovering) {
        isHovering = false;
        
        // Restore dot
        gsap.to(dot, { scale: 1, opacity: 1, duration: 0.2 });
        
        // Restore ring
        gsap.to(ring, {
          scale: 1,
          backgroundColor: 'transparent',
          borderColor: 'var(--color-accent-primary)',
          opacity: 1,
          duration: 0.3,
          ease: "power2.out"
        });
      }
    });
  };

  document.addEventListener('astro:page-load', initCursor);
</script>

<style is:global>
  @media (hover: hover) and (pointer: fine) {
    body, a, button, .interactive {
      cursor: none;
    }
  }
</style>
