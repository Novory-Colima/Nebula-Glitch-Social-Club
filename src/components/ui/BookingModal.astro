---
// src/components/ui/BookingModal.astro
import PremiumButton from './PremiumButton.astro';
import NoiseOverlay from './NoiseOverlay.astro';
---

<div 
  id="booking-modal" 
  class="fixed inset-0 z-[100] bg-black/80 backdrop-blur-md hidden opacity-0 flex items-center justify-center p-4 transition-all duration-300 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  aria-hidden="true"
>
  <!-- Modal Content Container -->
  <div 
    id="modal-content"
    class="relative w-full max-w-3xl bg-[var(--color-bg-secondary)] border border-[var(--color-border-subtle)] rounded-2xl overflow-hidden shadow-[inset_0_1px_0_rgba(255,255,255,0.1),_0_25px_50px_-12px_rgba(0,0,0,0.5)] flex flex-col md:flex-row max-h-[90vh] md:max-h-none overflow-y-auto md:overflow-visible scale-95 opacity-0 transition-all duration-500 pointer-events-auto"
  >
    <NoiseOverlay />
    <!-- Close Button -->
    <button 
      id="close-modal-btn" 
      class="absolute top-4 right-4 z-50 w-8 h-8 rounded-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] flex items-center justify-center text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:border-[var(--color-accent-primary)] transition-colors duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-accent-primary)]"
      aria-label="Cerrar modal"
    >
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Column 1: Editorial Branding (Hidden on mobile) -->
    <div class="hidden md:flex flex-col justify-between p-12 bg-gradient-to-br from-[var(--color-bg-primary)] to-[var(--color-surface)] w-2/5 border-r border-[var(--color-border-subtle)] relative overflow-hidden">
      <!-- Glow -->
      <div class="absolute -bottom-20 -left-20 w-48 h-48 rounded-full bg-[var(--color-accent-primary)] blur-[60px] opacity-10 pointer-events-none"></div>

      <div class="relative z-10 flex flex-col gap-6">
        <span class="text-[10px] uppercase tracking-[0.25em] text-[var(--color-accent-primary)] font-secondary">Experiencia Premium</span>
        <h2 id="modal-title" class="text-3xl font-display font-bold leading-tight text-[var(--color-text-primary)]">
          RESERVA TU ESPACIO
        </h2>
        <p class="text-xs text-[var(--color-text-secondary)] font-secondary leading-relaxed">
          Diseñado para quienes aprecian la precisión del café de especialidad y la fluidez del diseño contemporáneo.
        </p>
      </div>

      <div class="relative z-10 flex flex-col gap-4 border-t border-[var(--color-border-subtle)] pt-6">
        <div>
          <span class="text-[9px] uppercase tracking-widest text-[var(--color-text-secondary)] font-secondary block mb-1">Horario</span>
          <p class="text-xs text-[var(--color-text-primary)] font-secondary">Lun – Dom · 7:00 AM – 11:00 PM</p>
        </div>
        <div>
          <span class="text-[9px] uppercase tracking-widest text-[var(--color-text-secondary)] font-secondary block mb-1">Dirección</span>
          <p class="text-xs text-[var(--color-text-primary)] font-secondary">Col. Roma Norte, CDMX</p>
        </div>
      </div>
    </div>

    <!-- Column 2: Form -->
    <form id="booking-form" class="p-8 md:p-12 w-full md:w-3/5 flex flex-col gap-5 justify-center relative">
      <div class="md:hidden mb-4">
        <h2 class="text-2xl font-display font-bold text-[var(--color-text-primary)] tracking-wide">
          RESERVA TU ESPACIO
        </h2>
      </div>

      <!-- Full Name -->
      <div class="flex flex-col gap-1.5">
        <label for="booking-name" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Nombre completo</label>
        <input 
          type="text" 
          id="booking-name" 
          name="name" 
          required 
          class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300"
          placeholder="Ej. Carlos Fuentes"
        />
      </div>

      <!-- Email -->
      <div class="flex flex-col gap-1.5">
        <label for="booking-email" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Correo electrónico</label>
        <input 
          type="email" 
          id="booking-email" 
          name="email" 
          required 
          class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300"
          placeholder="carlos@ejemplo.com"
        />
      </div>

      <!-- Grid: Guests + Space -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Guests -->
        <div class="flex flex-col gap-1.5">
          <label for="booking-guests" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Personas</label>
          <select 
            id="booking-guests" 
            name="guests" 
            required 
            class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300 cursor-pointer"
          >
            <option value="1">1 Persona</option>
            <option value="2" selected>2 Personas</option>
            <option value="3">3 Personas</option>
            <option value="4">4 Personas</option>
            <option value="5">5 Personas</option>
            <option value="6+">6+ Personas</option>
          </select>
        </div>

        <!-- Space Preference -->
        <div class="flex flex-col gap-1.5">
          <label for="booking-space" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Espacio</label>
          <select 
            id="booking-space" 
            name="space" 
            required 
            class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300 cursor-pointer"
          >
            <option value="lounge">Lounge Principal</option>
            <option value="bar">La Barra</option>
            <option value="quiet">Zona Silenciosa</option>
            <option value="gaming">Gaming Lounge</option>
          </select>
        </div>
      </div>

      <!-- Grid: Date + Time -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Date -->
        <div class="flex flex-col gap-1.5">
          <label for="booking-date" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Fecha</label>
          <input 
            type="date" 
            id="booking-date" 
            name="date" 
            required 
            class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300 cursor-pointer"
          />
        </div>

        <!-- Time -->
        <div class="flex flex-col gap-1.5">
          <label for="booking-time" class="text-[10px] uppercase tracking-wider text-[var(--color-text-secondary)] font-secondary">Hora</label>
          <input 
            type="time" 
            id="booking-time" 
            name="time" 
            required 
            class="w-full bg-[var(--color-surface)] border border-[var(--color-border-subtle)] rounded-lg px-4 py-3 text-sm text-[var(--color-text-primary)] focus:outline-none focus:border-[var(--color-accent-primary)] focus:ring-1 focus:ring-[var(--color-accent-primary)] transition-all duration-300 cursor-pointer"
          />
        </div>
      </div>

      <!-- Submit button -->
      <div class="mt-4">
        <PremiumButton type="submit" id="submit-booking-btn" class="w-full py-4 text-center justify-center">
          Confirmar reservación
        </PremiumButton>
      </div>
    </form>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { getLenis } from '../../core/motion/ScrollManager';

  const initBookingModal = () => {
    const modal = document.getElementById('booking-modal');
    const content = document.getElementById('modal-content');
    const closeBtn = document.getElementById('close-modal-btn');
    const form = document.getElementById('booking-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-booking-btn');

    if (!modal || !content || !closeBtn || !form || !submitBtn) return;

    let previouslyFocusedElement: HTMLElement | null = null;
    let modalIsOpen = false;

    // Toast Container Creator
    const getToastContainer = () => {
      let container = document.getElementById('toast-container');
      if (!container) {
        container = document.createElement('div');
        container.id = 'toast-container';
        container.className = 'fixed bottom-6 right-6 z-[1000] flex flex-col gap-3 max-w-sm w-full pointer-events-none px-4 sm:px-0';
        document.body.appendChild(container);
      }
      return container;
    };

    // Premium Toast Trigger
    const showDemoToast = (title: string, message: string) => {
      const container = getToastContainer();
      
      const toast = document.createElement('div');
      toast.className = 'glass-panel p-5 rounded-xl border border-[rgba(107,90,255,0.25)] flex gap-4 pointer-events-auto shadow-2xl relative overflow-hidden opacity-0 translate-y-6';
      toast.style.background = 'rgba(13, 16, 23, 0.95)';
      toast.style.backdropFilter = 'blur(16px)';
      
      // Vertical accent bar
      const accentBar = document.createElement('div');
      accentBar.className = 'absolute top-0 left-0 w-1 h-full bg-[var(--color-accent-primary)]';
      toast.appendChild(accentBar);

      // Text wrapper
      const textWrapper = document.createElement('div');
      textWrapper.className = 'flex flex-col gap-1 pl-1';
      
      const toastTitle = document.createElement('span');
      toastTitle.className = 'text-xs uppercase tracking-wider font-display font-bold text-[var(--color-text-primary)]';
      toastTitle.innerText = title;
      textWrapper.appendChild(toastTitle);
      
      const toastMsg = document.createElement('p');
      toastMsg.className = 'text-[11px] text-[var(--color-text-secondary)] font-secondary leading-relaxed';
      toastMsg.innerText = message;
      textWrapper.appendChild(toastMsg);
      
      toast.appendChild(textWrapper);

      // Close button for toast
      const toastClose = document.createElement('button');
      toastClose.className = 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] text-xs flex items-start mt-0.5 ml-auto focus:outline-none';
      toastClose.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>`;
      toastClose.addEventListener('click', () => removeToast(toast));
      toast.appendChild(toastClose);

      container.appendChild(toast);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Animate In
      if (prefersReducedMotion) {
        gsap.set(toast, { opacity: 1, y: 0 });
      } else {
        gsap.to(toast, { opacity: 1, y: 0, duration: 0.4, ease: 'power3.out' });
      }

      // Auto dismiss
      const dismissTimeout = setTimeout(() => {
        removeToast(toast);
      }, 5000);

      const removeToast = (el: HTMLElement) => {
        clearTimeout(dismissTimeout);
        if (prefersReducedMotion) {
          el.remove();
        } else {
          gsap.to(el, {
            opacity: 0,
            y: -10,
            duration: 0.3,
            ease: 'power2.in',
            onComplete: () => el.remove()
          });
        }
      };
    };

    // Open Modal
    const openModal = () => {
      modalIsOpen = true;
      previouslyFocusedElement = document.activeElement as HTMLElement;

      modal.classList.remove('hidden');
      modal.classList.add('flex');
      modal.setAttribute('aria-hidden', 'false');
      modal.style.pointerEvents = 'auto';

      // Lock scrolling
      const lenis = getLenis();
      if (lenis) lenis.stop();
      document.body.style.overflow = 'hidden';

      // Minimum Date selection constraint (cannot book in past)
      const dateInput = document.getElementById('booking-date') as HTMLInputElement;
      if (dateInput) {
        const today = new Date().toISOString().split('T')[0];
        dateInput.min = today;
        dateInput.value = today;
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        gsap.set(modal, { opacity: 1 });
        gsap.set(content, { opacity: 1, scale: 1 });
        focusFirstElement();
      } else {
        gsap.to(modal, { opacity: 1, duration: 0.3, ease: 'power2.out' });
        gsap.fromTo(content, 
          { opacity: 0, scale: 0.95 },
          { opacity: 1, scale: 1, duration: 0.5, ease: 'power3.out', onComplete: focusFirstElement }
        );
      }
    };

    // Close Modal
    const closeModal = () => {
      modalIsOpen = false;
      modal.setAttribute('aria-hidden', 'true');
      modal.style.pointerEvents = 'none';

      // Unlock scrolling
      const lenis = getLenis();
      if (lenis) lenis.start();
      document.body.style.overflow = '';

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (prefersReducedMotion) {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        gsap.set(content, { opacity: 0, scale: 0.95 });
        restoreFocus();
      } else {
        gsap.to(content, {
          opacity: 0,
          scale: 0.95,
          duration: 0.3,
          ease: 'power3.in'
        });
        gsap.to(modal, {
          opacity: 0,
          duration: 0.3,
          ease: 'power2.in',
          onComplete: () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            restoreFocus();
          }
        });
      }
    };

    // Focus Utilities
    const getFocusableElements = () => {
      return content.querySelectorAll('button, input, select, textarea, [tabindex]:not([tabindex="-1"])');
    };

    const focusFirstElement = () => {
      const focusable = getFocusableElements();
      if (focusable.length > 0) {
        (focusable[0] as HTMLElement).focus();
      }
    };

    const restoreFocus = () => {
      if (previouslyFocusedElement) {
        previouslyFocusedElement.focus();
      }
    };

    // Key handlers (Focus Trap & ESC)
    window.addEventListener('keydown', (e) => {
      if (!modalIsOpen) return;

      if (e.key === 'Escape') {
        closeModal();
      }

      if (e.key === 'Tab') {
        const focusable = getFocusableElements();
        const first = focusable[0] as HTMLElement;
        const last = focusable[focusable.length - 1] as HTMLElement;

        if (e.shiftKey) {
          if (document.activeElement === first) {
            last.focus();
            e.preventDefault();
          }
        } else {
          if (document.activeElement === last) {
            first.focus();
            e.preventDefault();
          }
        }
      }
    });

    // Close on backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });

    closeBtn.addEventListener('click', closeModal);

    // Global Modal Trigger Delegation
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement).closest('.booking-trigger');
      if (target) {
        e.preventDefault();
        openModal();
      }
    });

    // Form Submission Simulation
    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Submit Button Loading state
      const origText = submitBtn.innerHTML;
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.innerHTML = `<span class="flex items-center gap-2 justify-center"><svg class="animate-spin h-4 w-4 text-current" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Procesando...</span>`;

      // Simulate network request
      setTimeout(() => {
        const data = new FormData(form);
        const name = data.get('name') as string;
        const spaceVal = data.get('space') as string;
        
        let spaceLabel = "Lounge Principal";
        if (spaceVal === 'bar') spaceLabel = "La Barra";
        else if (spaceVal === 'quiet') spaceLabel = "Zona Silenciosa";
        else if (spaceVal === 'gaming') spaceLabel = "Gaming Lounge";

        // Reset state
        submitBtn.removeAttribute('disabled');
        submitBtn.innerHTML = origText;
        form.reset();
        
        // Hide Modal
        closeModal();

        // Show Toast
        showDemoToast(
          "¡Reserva Solicitada!", 
          `Gracias ${name}. Tu mesa en ${spaceLabel} ha sido pre-registrada. Nota: Esta es una demostración de portafolio y no se guardó información real.`
        );
      }, 1500);
    });
  };

  document.addEventListener('astro:page-load', initBookingModal);
</script>
