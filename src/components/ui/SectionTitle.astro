---
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
  class?: string;
  id?: string;
}

const { as: Tag = 'h2', class: className = '', id } = Astro.props;
---

<Tag id={id} class:list={["section-title opacity-0 translate-y-8 font-display", className]}>
  <slot />
</Tag>

<script>
  import gsap from 'gsap';
  import ScrollTrigger from 'gsap/ScrollTrigger';
  import { EASINGS, DURATIONS } from '../../core/motion/tokens';

  const initTitles = () => {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const titles = document.querySelectorAll('.section-title');
    
    if (prefersReducedMotion) {
      titles.forEach((title) => {
        title.classList.remove('opacity-0', 'translate-y-8');
      });
      return;
    }

    titles.forEach((title) => {
      gsap.to(title, {
        scrollTrigger: {
          trigger: title,
          start: "top 85%", // Trigger slightly before it comes into view
        },
        opacity: 1,
        y: 0,
        duration: DURATIONS.entrance,
        ease: EASINGS.premiumEntrance,
      });
    });
  };

  document.addEventListener('astro:page-load', initTitles);
</script>
