---
// src/components/ui/Atmosphere.astro
---
<div id="atmosphere-container" class="fixed inset-0 pointer-events-none z-0 mix-blend-screen opacity-80"></div>

<script>
  import { SceneManager } from '../../core/webgl/SceneManager';

  const initAtmosphere = () => {
    const container = document.getElementById('atmosphere-container');
    if (!container) return;
    
    // Disable on mobile/reduced motion to save battery/performance
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || window.innerWidth < 768) {
      return;
    }

    const sceneManager = SceneManager.getInstance();
    sceneManager.init(container);

    // Cleanup
    document.addEventListener('astro:before-preparation', () => {
      sceneManager.destroy();
    }, { once: true });
  };

  document.addEventListener('astro:page-load', initAtmosphere);
</script>
