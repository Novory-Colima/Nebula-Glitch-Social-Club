---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main class="min-h-[200vh] flex flex-col items-center justify-center">
    <div class="glass-panel p-12 text-center rounded-2xl max-w-2xl border border-[var(--color-border-subtle)]">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 text-glow-primary text-balance text-[var(--color-text-primary)]">
        Nebula Glitch Social Club
      </h1>
      <p class="text-[var(--color-text-secondary)] text-lg mb-8 font-secondary">
        Project Foundation Initialized. Awaiting Phase 3 (Components Development).
      </p>
      
      <div class="flex gap-4 justify-center">
        <div class="w-3 h-3 rounded-full bg-[var(--color-accent-primary)] animate-pulse"></div>
        <div class="w-3 h-3 rounded-full bg-[var(--color-glow-secondary)] animate-pulse delay-75"></div>
        <div class="w-3 h-3 rounded-full bg-[var(--color-highlight)] animate-pulse delay-150"></div>
      </div>
    </div>
  </main>
</BaseLayout>
