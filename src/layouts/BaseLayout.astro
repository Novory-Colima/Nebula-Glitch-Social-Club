---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Nebula Glitch Social Club', 
  description = 'Cafetería premium de especialidad con diseño contemporáneo, tecnología integrada y gaming lounge — CDMX.' 
} = Astro.props;

import NoiseOverlay from '../components/ui/NoiseOverlay.astro';
import CustomCursor from '../components/ui/CustomCursor.astro';
import Atmosphere from '../components/ui/Atmosphere.astro';
import Navbar from '../components/sections/Navbar.astro';
import BookingModal from '../components/ui/BookingModal.astro';
import NovoryTopBar from '../novory/NovoryTopBar.astro';
import NovoryFloatingBadge from '../novory/NovoryFloatingBadge.astro';
import '../novory/novory.css';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social Media Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${import.meta.env.BASE_URL}novory-logotipo-horizontal-color-dark-og.png`, Astro.site ?? Astro.url)} />
    
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${import.meta.env.BASE_URL}novory-icon-color-dark-192.png`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${import.meta.env.BASE_URL}novory-icon-color-dark-512.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}novory-apple-touch-icon.png`} />
    <link rel="manifest" href={`${import.meta.env.BASE_URL}manifest.json`} />
    <meta name="theme-color" content="#06070B" />
    
    <title>{title}</title>
    
    <ClientRouter />
    
    <!-- Inline script to handle theme and dynamic a11y preferences -->
    <script is:inline>
      const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      
      const updateMotionPreference = (e) => {
        if (e.matches) {
          document.documentElement.classList.add('reduced-motion');
        } else {
          document.documentElement.classList.remove('reduced-motion');
        }
      };
      
      // Check initially
      updateMotionPreference(mediaQuery);
      // Listen for dynamic OS changes
      mediaQuery.addEventListener('change', updateMotionPreference);
    </script>
  </head>
  <body class="antialiased selection:bg-[var(--color-accent-primary)] selection:text-[var(--color-text-primary)] pt-[102px] md:pt-[118px]">
    <NovoryTopBar />
    <Navbar />
    <Atmosphere />
    <NoiseOverlay />
    <CustomCursor />
    
    <!-- Slot for Page Content -->
    <slot />

    <BookingModal />
    <NovoryFloatingBadge />

    <!-- Motion System Initialization -->
    <script>
      import { initScroll, destroyScroll, refreshScroll } from '../core/motion/ScrollManager';
      
      const initApp = () => {
        // Respect accessibility settings
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion) {
          initScroll();
        }
      };

      // Initialize on first load
      initApp();

      // Handle View Transitions (Astro native)
      document.addEventListener('astro:page-load', () => {
        initApp();
        // Crucial: Recalculate GSAP triggers when DOM morphs and height changes
        refreshScroll();
      });
      
      // Cleanup on page leave to avoid memory leaks
      document.addEventListener('astro:before-preparation', destroyScroll);
    </script>
  </body>
</html>
