---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = 'Nebula Glitch Social Club', 
  description = 'Immersive Gaming Lounge Showcase built with Astro.' 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Open Graph / Social Media Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    
    <title>{title}</title>
    
    <ClientRouter />
    
    <!-- Inline script to handle theme and dynamic a11y preferences -->
    <script is:inline>
      const mediaQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      
      const updateMotionPreference = (e) => {
        if (e.matches) {
          document.documentElement.classList.add('reduced-motion');
        } else {
          document.documentElement.classList.remove('reduced-motion');
        }
      };
      
      // Check initially
      updateMotionPreference(mediaQuery);
      // Listen for dynamic OS changes
      mediaQuery.addEventListener('change', updateMotionPreference);
    </script>
  </head>
  <body class="antialiased selection:bg-[var(--color-accent-primary)] selection:text-[var(--color-text-primary)]">
    <!-- Slot for Page Content -->
    <slot />

    <!-- Motion System Initialization -->
    <script>
      import { initScroll, destroyScroll, refreshScroll } from '../core/motion/ScrollManager';
      
      const initApp = () => {
        // Respect accessibility settings
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!prefersReducedMotion) {
          initScroll();
        }
      };

      // Initialize on first load
      initApp();

      // Handle View Transitions (Astro native)
      document.addEventListener('astro:page-load', () => {
        initApp();
        // Crucial: Recalculate GSAP triggers when DOM morphs and height changes
        refreshScroll();
      });
      
      // Cleanup on page leave to avoid memory leaks
      document.addEventListener('astro:before-preparation', destroyScroll);
    </script>
  </body>
</html>
